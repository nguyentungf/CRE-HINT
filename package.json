  "private": true,
  "description": "CRE-HINT - Hệ thống Quản lý Bệnh án và Hỗ trợ Lâm sàng Thông minh (Clinical Record Entry & Healthcare Information System)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
